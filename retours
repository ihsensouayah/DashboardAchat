<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suivi Retours Fournisseur — AUTOP Tunisie</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<style>
  :root{
    --navy:#20496d; --navy-dark:#163554; --red:#db0c15; --orange:#e8891f;
    --bg:#f2f4f7; --card:#ffffff; --line:#e4e8ee; --text:#1c2b3a; --muted:#6b7c8f;
  }
  *{box-sizing:border-box;}
  body{
    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background:var(--bg); color:var(--text); margin:0;
  }
  .watermark{
    position:fixed; inset:0; pointer-events:none; z-index:0;
    display:flex; align-items:center; justify-content:center;
    opacity:.04; transform:rotate(-28deg);
    font-size:11rem; font-weight:800; letter-spacing:.02em; color:var(--navy);
    white-space:nowrap;
  }
  header{
    position:sticky; top:0; z-index:20;
    background:linear-gradient(180deg,var(--navy),var(--navy-dark));
    border-bottom:3px solid var(--red);
    color:#fff; padding:14px 22px;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    flex-wrap:wrap;
  }
  header h1{margin:0; font-size:1.15rem; font-weight:700; letter-spacing:.01em;}
  header .sub{font-size:.72rem; color:#c9d6e4; margin-top:2px;}
  .btn{
    border:none; border-radius:6px; padding:8px 14px; font-size:.82rem; font-weight:600;
    cursor:pointer; display:inline-flex; align-items:center; gap:6px; transition:filter .15s;
  }
  .btn:hover{filter:brightness(1.08);}
  .btn-primary{background:var(--orange); color:#fff;}
  .btn-ghost{background:rgba(255,255,255,.12); color:#fff;}
  .btn-danger{background:var(--red); color:#fff;}
  main{position:relative; z-index:1; max-width:1400px; margin:0 auto; padding:20px 22px 60px;}

  .kpi-grid{
    display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:22px;
  }
  @media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:640px){.kpi-grid{grid-template-columns:repeat(2,1fr);}}
  .kpi{
    background:var(--card); border:1px solid var(--line); border-top:3px solid var(--navy);
    border-radius:8px; padding:14px 12px;
  }
  .kpi.accent-red{border-top-color:var(--red);}
  .kpi.accent-orange{border-top-color:var(--orange);}
  .kpi .label{font-size:.68rem; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; font-weight:600;}
  .kpi .value{font-size:1.55rem; font-weight:700; color:var(--navy); margin-top:4px;}

  .panel{
    background:var(--card); border:1px solid var(--line); border-radius:8px; overflow:hidden;
  }
  .panel-head{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
    padding:14px 16px; border-bottom:1px solid var(--line);
  }
  .panel-head h2{margin:0; font-size:.95rem; font-weight:700; color:var(--navy);}
  .filters{display:flex; gap:8px; flex-wrap:wrap;}
  select.filter, input.filter{
    border:1px solid var(--line); border-radius:6px; padding:6px 8px; font-size:.78rem;
    background:#fff; color:var(--text);
  }
  table{width:100%; border-collapse:collapse; font-size:.78rem;}
  thead th{
    background:#eef2f7; color:var(--navy); text-align:left; padding:8px 8px;
    border-bottom:1px solid var(--line); white-space:nowrap; font-weight:700;
  }
  tbody td{padding:5px 6px; border-bottom:1px solid var(--line); vertical-align:middle;}
  tbody tr:hover{background:#f8fafc;}
  tbody input, tbody select{
    width:100%; border:1px solid transparent; background:transparent; padding:4px 5px;
    border-radius:4px; font-size:.78rem; color:var(--text); font-family:inherit;
  }
  tbody input:hover, tbody select:hover{border-color:var(--line);}
  tbody input:focus, tbody select:focus{border-color:var(--orange); outline:none; background:#fff;}
  .row-retourne{background:#e9f6ec;}
  .row-non-retourne{background:#fdecec;}
  .del-btn{
    background:none; border:none; color:var(--red); cursor:pointer; font-size:.95rem;
    padding:2px 6px; border-radius:4px;
  }
  .del-btn:hover{background:#fdecec;}
  .table-wrap{overflow-x:auto;}
  .empty-state{padding:34px; text-align:center; color:var(--muted); font-size:.85rem;}
  footer{
    max-width:1400px; margin:0 auto; padding:8px 22px 30px; color:var(--muted); font-size:.72rem;
  }
  .save-indicator{font-size:.72rem; color:#c9d6e4; display:flex; align-items:center; gap:6px;}
  .dot{width:7px; height:7px; border-radius:50%; background:#7ddc8c;}
</style>
</head>
<body>
<div class="watermark">AUTOP</div>

<header>
  <div>
    <h1>Suivi des Retours Fournisseur</h1>
    <div class="sub">AUTOP Tunisie — dashboard autonome</div>
  </div>
  <div style="display:flex; align-items:center; gap:10px;">
    <span class="save-indicator" id="saveIndicator"><span class="dot"></span> Enregistré</span>
    <input type="file" id="importInput" accept=".xlsx,.xls,.csv" style="display:none;">
    <button class="btn btn-ghost" id="importBtn">Importer Excel</button>
    <button class="btn btn-ghost" id="exportBtn">Exporter Excel</button>
    <button class="btn btn-primary" id="addRowBtn">+ Nouveau dossier</button>
  </div>
</header>

<main>
  <div class="kpi-grid" id="kpiGrid"></div>

  <div class="panel">
    <div class="panel-head">
      <h2>Dossiers de retour</h2>
      <div class="filters">
        <select class="filter" id="filterMarque"><option value="">Toutes marques</option></select>
        <select class="filter" id="filterStatutRetour">
          <option value="">Tout statut retour</option>
          <option>Retourné</option><option>Non Retourné</option><option>En cours</option>
        </select>
        <select class="filter" id="filterStatutReception">
          <option value="">Tout statut réception</option>
          <option>Reçu</option><option>Non Reçu</option><option>Partiellement Reçu</option>
        </select>
        <input class="filter" id="searchBox" placeholder="Rechercher (dossier, VIN, fournisseur...)" style="width:220px;">
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>N° Dossier</th><th>VIN</th><th>Marque</th><th>Désignation Pièce</th>
            <th>Référence</th><th>Fournisseur</th><th>Emplacement</th><th>Statut Retour</th>
            <th>Date Retour</th><th>Statut Récep.</th><th>Date Récep.</th><th>Motif Retour</th>
            <th>Valeur (DT)</th><th>Responsable</th><th>N° Bon Retour</th><th>Commentaire</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
      <div class="empty-state" id="emptyState" style="display:none;">Aucun dossier. Clique sur "+ Nouveau dossier" pour commencer.</div>
    </div>
  </div>
</main>

<footer>Dashboard local — les données sont sauvegardées automatiquement dans ton espace Claude. Utilise "Exporter Excel" pour partager ou archiver.</footer>

<script>
const MARQUES = ['RENAULT','DACIA','PEUGEOT','CITROEN','VOLKSWAGEN','HYUNDAI','KIA','TOYOTA','FIAT','OPEL','FORD','NISSAN','SUZUKI','CHERY','DONGFENG','MG','SEAT','SKODA','MERCEDES','BMW','AUDI','ISUZU','MITSUBISHI','CHEVROLET'];
const EMPLACEMENTS = ['Magasin','Garage'];
const STATUTS_RETOUR = ['Retourné','Non Retourné','En cours'];
const STATUTS_RECEPTION = ['Reçu','Non Reçu','Partiellement Reçu'];
const STORAGE_KEY = 'autop_suivi_retours_dossiers';

let dossiers = [];
let saveTimer = null;

function uid(){ return 'd_' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

// Persistance : ce module est intégré en iframe via data: URI dans le dashboard
// principal, ce qui donne à Chrome une origine "opaque" et bloque l'accès à
// localStorage/indexedDB (SecurityError) — les données ne survivaient donc jamais à un
// rechargement de la page. On utilise donc Firestore (même projet que le dashboard
// principal) comme source de vérité, avec un cache mémoire local pour un rendu instantané
// pendant le chargement réseau.
const firebaseConfig = {
  apiKey: "AIzaSyDjaYzS64cTQ63ozYzSgRZSyqPgqpmJgGI",
  authDomain: "autopachat.firebaseapp.com",
  projectId: "autopachat",
  storageBucket: "autopachat.firebasestorage.app",
  messagingSenderId: "61990255227",
  appId: "1:61990255227:web:2126c73037ed2c07fbc0de",
  measurementId: "G-CWTLMD8K3Y"
};
if(!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();
const retoursDocRef = db.collection('appModulesData').doc(STORAGE_KEY);

let __memoryStore = {};

async function loadFromFirestore(key){
  try{
    const snap = await retoursDocRef.get();
    if(snap.exists){
      const data = snap.data();
      if(typeof data.value === 'string'){ __memoryStore[key] = data.value; return data.value; }
    }
  }catch(e){
    console.error('Firestore load error', e);
  }
  return null;
}

async function saveToFirestore(key, value){
  __memoryStore[key] = value;
  await retoursDocRef.set({
    value: value,
    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
  });
}

function blankDossier(){
  return {
    id: uid(), numDossier:'', vin:'', marque:'', designation:'', reference:'',
    fournisseur:'', emplacement:'Garage', statutRetour:'Non Retourné', dateRetour:'',
    statutReception:'Non Reçu', dateReception:'', motif:'', valeur:'', responsable:'',
    numBonRetour:'', commentaire:''
  };
}

async function loadData(){
  const ind = document.getElementById('saveIndicator');
  if(ind) ind.innerHTML = '<span class="dot" style="background:#e8891f;"></span> Chargement...';
  try{
    const raw = await loadFromFirestore(STORAGE_KEY);
    dossiers = raw ? JSON.parse(raw) : [];
    if(ind) ind.innerHTML = '<span class="dot"></span> Enregistré';
  }catch(e){
    console.error('Erreur de chargement Firestore', e);
    dossiers = [];
    if(ind) ind.innerHTML = '<span class="dot" style="background:#db0c15;"></span> Erreur de chargement';
  }
  if(dossiers.length === 0){
    dossiers.push(Object.assign(blankDossier(), {
      numDossier:'DOS-2026-0145', vin:'VF1BG000012345678', marque:'RENAULT',
      designation:'Alternateur', reference:'REF-ALT-0021', fournisseur:'PIECES AUTO SFAX',
      emplacement:'Garage', statutRetour:'Non Retourné', statutReception:'Non Reçu',
      motif:'Pièce défectueuse (garantie)', valeur:'350', responsable:'Achref',
      commentaire:'Exemple - modifie ou supprime cette ligne'
    }));
  }
  render();
}

function scheduleSave(){
  const ind = document.getElementById('saveIndicator');
  ind.innerHTML = '<span class="dot" style="background:#e8891f;"></span> Enregistrement...';
  clearTimeout(saveTimer);
  saveTimer = setTimeout(async () => {
    try{
      await saveToFirestore(STORAGE_KEY, JSON.stringify(dossiers));
      ind.innerHTML = '<span class="dot"></span> Enregistré';
    }catch(e){
      console.error('Erreur de sauvegarde Firestore', e);
      ind.innerHTML = '<span class="dot" style="background:#db0c15;"></span> Erreur de sauvegarde';
    }
  }, 500);
}

function fillMarqueFilter(){
  const sel = document.getElementById('filterMarque');
  sel.innerHTML = '<option value="">Toutes marques</option>' +
    MARQUES.map(m => `<option value="${m}">${m}</option>`).join('');
}

function currentFilters(){
  return {
    marque: document.getElementById('filterMarque').value,
    statutRetour: document.getElementById('filterStatutRetour').value,
    statutReception: document.getElementById('filterStatutReception').value,
    search: document.getElementById('searchBox').value.trim().toLowerCase(),
  };
}

function filteredDossiers(){
  const f = currentFilters();
  return dossiers.filter(d => {
    if(f.marque && d.marque !== f.marque) return false;
    if(f.statutRetour && d.statutRetour !== f.statutRetour) return false;
    if(f.statutReception && d.statutReception !== f.statutReception) return false;
    if(f.search){
      const hay = [d.numDossier,d.vin,d.fournisseur,d.designation,d.reference,d.responsable].join(' ').toLowerCase();
      if(!hay.includes(f.search)) return false;
    }
    return true;
  });
}

function renderKpis(){
  const total = dossiers.length;
  const retournees = dossiers.filter(d => d.statutRetour === 'Retourné').length;
  const nonRetournees = dossiers.filter(d => d.statutRetour === 'Non Retourné').length;
  const recues = dossiers.filter(d => d.statutReception === 'Reçu').length;
  const nonRecues = dossiers.filter(d => d.statutReception === 'Non Reçu').length;
  const valeurTotale = dossiers.reduce((s,d) => s + (parseFloat(d.valeur) || 0), 0);

  const cards = [
    {label:'Total Dossiers', value: total, accent:''},
    {label:'Retournées', value: retournees, accent:''},
    {label:'Non Retournées', value: nonRetournees, accent:'accent-red'},
    {label:'Reçues', value: recues, accent:''},
    {label:'Non Reçues', value: nonRecues, accent:'accent-red'},
    {label:'Valeur Totale (DT)', value: valeurTotale.toLocaleString('fr-FR',{maximumFractionDigits:0}), accent:'accent-orange'},
  ];
  document.getElementById('kpiGrid').innerHTML = cards.map(c => `
    <div class="kpi ${c.accent}">
      <div class="label">${c.label}</div>
      <div class="value">${c.value}</div>
    </div>`).join('');
}

function opts(list, selected){
  return list.map(v => `<option value="${v}" ${v===selected?'selected':''}>${v}</option>`).join('');
}

function renderRows(){
  const rows = filteredDossiers();
  const tbody = document.getElementById('tbody');
  document.getElementById('emptyState').style.display = rows.length ? 'none' : 'block';

  tbody.innerHTML = rows.map(d => {
    const rowClass = d.statutRetour === 'Retourné' ? 'row-retourne' : (d.statutRetour === 'Non Retourné' ? 'row-non-retourne' : '');
    return `
    <tr class="${rowClass}" data-id="${d.id}">
      <td><button class="del-btn" data-action="delete" title="Supprimer">✕</button></td>
      <td><input data-field="numDossier" value="${d.numDossier}" style="min-width:110px;"></td>
      <td><input data-field="vin" value="${d.vin}" style="min-width:150px;"></td>
      <td><select data-field="marque"><option value="">—</option>${opts(MARQUES, d.marque)}</select></td>
      <td><input data-field="designation" value="${d.designation}" style="min-width:130px;"></td>
      <td><input data-field="reference" value="${d.reference}" style="min-width:110px;"></td>
      <td><input data-field="fournisseur" value="${d.fournisseur}" style="min-width:140px;"></td>
      <td><select data-field="emplacement">${opts(EMPLACEMENTS, d.emplacement)}</select></td>
      <td><select data-field="statutRetour">${opts(STATUTS_RETOUR, d.statutRetour)}</select></td>
      <td><input type="date" data-field="dateRetour" value="${d.dateRetour}"></td>
      <td><select data-field="statutReception">${opts(STATUTS_RECEPTION, d.statutReception)}</select></td>
      <td><input type="date" data-field="dateReception" value="${d.dateReception}"></td>
      <td><input data-field="motif" value="${d.motif}" style="min-width:140px;"></td>
      <td><input data-field="valeur" value="${d.valeur}" style="width:75px;" inputmode="decimal"></td>
      <td><input data-field="responsable" value="${d.responsable}" style="min-width:100px;"></td>
      <td><input data-field="numBonRetour" value="${d.numBonRetour}" style="min-width:100px;"></td>
      <td><input data-field="commentaire" value="${d.commentaire}" style="min-width:160px;"></td>
    </tr>`;
  }).join('');
}

function render(){
  renderKpis();
  renderRows();
}

document.getElementById('tbody').addEventListener('input', e => {
  const field = e.target.getAttribute('data-field');
  if(!field) return;
  const tr = e.target.closest('tr');
  const id = tr.getAttribute('data-id');
  const d = dossiers.find(x => x.id === id);
  if(!d) return;
  d[field] = e.target.value;
  if(field === 'statutRetour'){
    tr.className = e.target.value === 'Retourné' ? 'row-retourne' : (e.target.value === 'Non Retourné' ? 'row-non-retourne' : '');
  }
  if(['valeur','statutRetour','statutReception'].includes(field)) renderKpis();
  scheduleSave();
});

document.getElementById('tbody').addEventListener('click', e => {
  if(e.target.getAttribute('data-action') === 'delete'){
    const tr = e.target.closest('tr');
    const id = tr.getAttribute('data-id');
    if(confirm('Supprimer ce dossier ?')){
      dossiers = dossiers.filter(x => x.id !== id);
      render();
      scheduleSave();
    }
  }
});

document.getElementById('addRowBtn').addEventListener('click', () => {
  dossiers.unshift(blankDossier());
  render();
  scheduleSave();
});

['filterMarque','filterStatutRetour','filterStatutReception'].forEach(id => {
  document.getElementById(id).addEventListener('change', renderRows);
});
document.getElementById('searchBox').addEventListener('input', renderRows);

function normalizeHeader(s){
  return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .toLowerCase().replace(/[^a-z0-9]/g,'');
}

const HEADER_FIELD_MAP = {
  ndossier: 'numDossier',
  vin: 'vin',
  marque: 'marque',
  designationpiece: 'designation',
  referencepiece: 'reference',
  fournisseur: 'fournisseur',
  emplacementpiece: 'emplacement',
  statutretour: 'statutRetour',
  dateretour: 'dateRetour',
  statutreception: 'statutReception',
  datereception: 'dateReception',
  motifretour: 'motif',
  valeurpiecedt: 'valeur',
  responsable: 'responsable',
  nbonretour: 'numBonRetour',
  commentaire: 'commentaire',
};

function formatCellDate(v){
  if(v instanceof Date && !isNaN(v)){
    return v.toISOString().slice(0,10);
  }
  return v == null ? '' : v.toString();
}

document.getElementById('importBtn').addEventListener('click', () => {
  document.getElementById('importInput').click();
});

document.getElementById('importInput').addEventListener('change', (e) => {
  const file = e.target.files[0];
  if(!file) return;

  const reader = new FileReader();
  reader.onload = (evt) => {
    try{
      const data = new Uint8Array(evt.target.result);
      const wb = XLSX.read(data, {type:'array', cellDates:true});
      const wsName = wb.SheetNames.includes('Suivi Retours') ? 'Suivi Retours' : wb.SheetNames[0];
      const ws = wb.Sheets[wsName];
      const rawRows = XLSX.utils.sheet_to_json(ws, {defval:'', raw:true});

      if(rawRows.length === 0){
        alert('Aucune ligne trouvée dans ce fichier.');
        return;
      }

      const importedDossiers = rawRows.map(row => {
        const d = blankDossier();
        Object.keys(row).forEach(colName => {
          const key = normalizeHeader(colName);
          const field = HEADER_FIELD_MAP[key];
          if(field){
            const val = row[colName];
            d[field] = (field === 'dateRetour' || field === 'dateReception')
              ? formatCellDate(val)
              : (val == null ? '' : val.toString());
          }
        });
        return d;
      }).filter(d => d.numDossier || d.vin || d.designation); // ignore lignes totalement vides

      if(importedDossiers.length === 0){
        alert('Aucune colonne reconnue dans ce fichier. Vérifie que les en-têtes correspondent (N° Dossier, VIN, Marque, ...).');
        return;
      }

      const remplacer = confirm(
        `${importedDossiers.length} dossier(s) trouvé(s) dans le fichier.\n\n` +
        `OK = remplacer les ${dossiers.length} dossier(s) actuel(s)\n` +
        `Annuler = ajouter à la suite des dossiers existants`
      );

      dossiers = remplacer ? importedDossiers : [...dossiers, ...importedDossiers];
      render();
      scheduleSave();
    }catch(err){
      alert('Erreur de lecture du fichier : ' + err.message);
    }finally{
      e.target.value = '';
    }
  };
  reader.readAsArrayBuffer(file);
});

document.getElementById('exportBtn').addEventListener('click', () => {
  const headers = ['N° Dossier','VIN','Marque','Désignation Pièce','Référence Pièce','Fournisseur','Emplacement Pièce','Statut Retour','Date Retour','Statut Réception','Date Réception','Motif Retour','Valeur Pièce (DT)','Responsable','N° Bon Retour','Commentaire'];
  const rows = dossiers.map(d => [d.numDossier,d.vin,d.marque,d.designation,d.reference,d.fournisseur,d.emplacement,d.statutRetour,d.dateRetour,d.statutReception,d.dateReception,d.motif,d.valeur,d.responsable,d.numBonRetour,d.commentaire]);
  const ws = XLSX.utils.aoa_to_sheet([headers, ...rows]);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Suivi Retours');
  XLSX.writeFile(wb, 'Suivi_Retours_Fournisseur_AUTOP.xlsx');
});

fillMarqueFilter();
try{
  loadData();
}catch(err){
  console.error('Erreur de démarrage', err);
  const el = document.createElement('div');
  el.style.cssText = 'background:#fde2e2;color:#a30a10;border-bottom:2px solid #db0c15;padding:10px 16px;font-size:12px;font-family:Segoe UI,Arial,sans-serif;text-align:center;';
  el.textContent = "Erreur d'affichage : " + (err && err.message ? err.message : err) + " — rechargez la page.";
  document.body.insertBefore(el, document.body.firstChild);
}
</script>
</body>
</html>
